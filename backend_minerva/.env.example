# Django Settings
# SECURITY: Set DEBUG=True only for development. Production must use DEBUG=False
DEBUG=True

# SECURITY: SECRET_KEY is REQUIRED and must be unique for each installation
# Generate a new one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# ALLOWED_HOSTS: Comma-separated list of allowed hosts
# For local development: localhost,127.0.0.1
# For Docker: localhost,127.0.0.1,backend
# For production: add your domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Choose ONE configuration below based on your environment:

# --- OPTION 1: SQLite (Local Development Only - NOT recommended for Docker) ---
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# --- OPTION 2: PostgreSQL (Docker or Local PostgreSQL) ---
# IMPORTANT: When using Docker, use these exact values to match docker-compose.yml
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=minerva_db
# DATABASE_USER=minerva_user
# DATABASE_PASSWORD=minerva_password
# DATABASE_HOST=db                    # Use 'db' for Docker, 'localhost' for local PostgreSQL
# DATABASE_PORT=5432

# Note: PostgreSQL + pgvector extension is REQUIRED for:
# - Vector embeddings (RAG/semantic search)
# - Production deployments
# - Docker environments (both dev and production)

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Google Gemini AI (usado para embeddings — text-embedding-004)
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# ALICE AI — DEEPSEEK (LLM principal)
# ==========================================
# DeepSeek API — API OpenAI-compatible
# Obtenha sua chave em: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
# ALICE AI — OBSERVABILIDADE (opcional)
# ==========================================
# LangSmith — rastreamento de chamadas LangChain
# Obtenha sua chave em: https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your-langsmith-key-here
# LANGCHAIN_PROJECT=minerva-alice

# Sentry — monitoramento de erros em produção
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ==========================================
# ALICE AI — MEMÓRIA
# ==========================================
# TTL da memória de curto prazo no Redis (segundos, padrão = 86400 = 24h)
# ALICE_REDIS_MEMORY_TTL=86400
# Número de mensagens mantidas no Redis por sessão
# ALICE_MEMORY_WINDOW=20
# Confiança mínima — abaixo disso, exibe aviso ao usuário (0.0-1.0)
# ALICE_CONFIDENCE_THRESHOLD=0.70

# Redis — broker do Celery (notificações e tarefas assíncronas)
# Dev local: redis://localhost:6379/0 (requer Redis instalado)
# Docker: configurado automaticamente pelo docker-compose
REDIS_URL=redis://localhost:6379/0

# Email — obrigatório para convites e notificações de vencimento de contrato
# Dev: "console" imprime no terminal sem enviar e-mail de verdade
# Produção: trocar para smtp e preencher as demais variáveis
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@sistemacontratos.local

# Security Settings (for production)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
