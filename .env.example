# Docker: copie para .env somente se esse arquivo ainda nao existir.
# Gere SECRET_KEY conforme o README. Nao versione o .env com credenciais.
SECRET_KEY=
APP_URL=http://localhost:4002
CORS_ALLOWED_ORIGINS=http://localhost:4002
GEMINI_API_KEY=

# E-mail: console enquanto o SMTP nao estiver configurado.
# Para enviar, troque o backend abaixo por django.core.mail.backends.smtp.EmailBackend
# e preencha host, usuario, senha e remetente.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
